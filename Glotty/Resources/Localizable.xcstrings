    "Every translate, explain, and polish run, newest first. Click any row to reopen the original popup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Übersetzungs-, Erklärungs- und Polierausführung, neueste zuerst. Klicken Sie auf eine beliebige Zeile, um das ursprüngliche Popup erneut zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
