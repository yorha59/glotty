    "e.g. \\u{201C}Loves indie games and dry humor. Bilingual in French.\\u{201D}": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z.B. \\u{201C}Liebe Indie-Spiele und trockenen Humor. Zweisprachig in Französisch.\\u{201D}"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "por ejemplo \\u{201C}Le gustan los juegos independientes y el humor seco. Bilingüe en francés.\\u{201D}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "par ex. \\u{201C}Aime les jeux indépendants et l'humour sec. Bilingue en français.\\u{201D}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: \\u{201C}インディーゲームとドライなユーモアが好き。フランス語のバイリンガル。\\u{201D}"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: \\u{201C}인디 게임과 건조한 유머를 좋아합니다. 프랑스어 이중 언어 구사자.\\u{201D}"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：\"喜欢独立游戏和冷幽默。法语双语者。\""
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：\\u{201C}喜歡獨立遊戲和冷幽默。法語雙語。\\u{201D}"
          }
        }
      }
    },
