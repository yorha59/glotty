    "This will OVERWRITE existing preferences, memories, contexts, chat history, and activity history on this machine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies wird BESTEHENDE Einstellungen, Erinnerungen, Kontexte, Chat-Verlauf und Aktivitätsverlauf auf diesem Gerät ÜBERSCHREIBEN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto SOBRESCRIBIRÁ las preferencias existentes, los recuerdos, los contextos, el historial de chat y el historial de actividad en esta máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
