    "Accepted memories with scope, pending suggestions, your defined contexts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Akzeptierte Erinnerungen mit Umfang, ausstehende Vorschläge, Ihre definierten Kontexte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerdos aceptados con ámbito, sugerencias pendientes, tus contextos definidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souvenirs acceptés avec portée, suggestions en attente, vos contextes définis."
          }
