    "Two commands are bound to the same key — only the first will fire.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Befehle sind derselben Taste zugeordnet — nur der erste wird ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos comandos están asignados a la misma tecla; solo se ejecutará el primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux commandes sont assignées à la même touche — seule la première sera exécutée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのコマンドが同じキーに割り当てられています — 最初のコマンドのみが実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 명령이 동일한 키에 바인딩되어 있습니다 — 첫 번째 명령만 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个命令绑定了同一个按键 —— 只有第一个会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個命令綁定到同一個按鍵上 — 只有第一個會觸發。"
          }
        }
      }
    },
