    "Memories are only extracted when you click 'Extract memories' in the chat. Lower cost.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen werden nur extrahiert, wenn du auf 'Erinnerungen extrahieren' im Chat klickst. Geringere Kosten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memories are only extracted when you click 'Extract memories' in the chat. Lower cost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las memorias solo se extraen cuando haces clic en 'Extraer memorias' en el chat. Costo reducido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les souvenirs ne sont extraits que lorsque vous cliquez sur 'Extraire les souvenirs' dans le chat. Coût inférieur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリはチャット内の「メモリを抽出」をクリックした場合のみ抽出されます。コストが低くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리는 채팅에서 '메모리 추출'을 클릭할 때만 추출됩니다. 비용이 저렴합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在聊天中点击「提取记忆」时才会提取记忆。消耗较低。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在聊天中點擊「提取記憶」時才會提取記憶。成本較低。"
          }
        }
      }
    },
