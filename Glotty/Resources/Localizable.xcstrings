        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スコープ付きの受け入れ済み記憶、保留中の提案、定義済みのコンテキスト。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범위가 지정된 수락된 기억, 보류 중인 제안, 정의된 컨텍스트."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带范围的已接受记忆、待审阅的建议、你定义的上下文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已接受的記憶（帶範圍）、待處理的建議，以及您定義的上下文。"
