    "Re-translates the UI in the current language via the LLM, applying any wording preferences from your accepted memories.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzt die Benutzeroberfläche erneut in der aktuellen Sprache über das LLM und wendet alle Wortwahl-Präferenzen aus Ihren akzeptierten Erinnerungen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-translates the UI in the current language via the LLM, applying any wording preferences from your accepted memories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a traducir la interfaz en el idioma actual mediante el LLM, aplicando cualquier preferencia de redacción de tus memorias aceptadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétraduit l'interface dans la langue actuelle via le LLM, en appliquant les préférences de formulation de vos mémoires acceptées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM経由で現在の言語でUIを再翻訳し、受け入れ済みのメモリからの表現の設定を適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LLM을 통해 현재 언어로 UI를 재번역하고, 수락된 메모리에서 가져온 모든 어휘 기본 설정을 적용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用当前语言通过 LLM 重新翻译界面，并套用你已接受的记忆中的用词偏好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 LLM 重新以當前語言翻譯介面，並套用您已接受記憶中的任何用詞偏好。"
          }
        }
      }
    },
