    "This removes every recorded LLM call from local history. The setting cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt alle aufgezeichneten LLM-Aufrufe aus dem lokalen Verlauf. Die Einstellung kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todas las llamadas registradas de LLM del historial local. La configuración no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci supprime chaque appel enregistré au LLM de l'historique local. Le paramètre ne peut pas être annulé."
